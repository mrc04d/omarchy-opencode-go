#!/usr/bin/python3
# omarchy:summary=Print the OpenCode Go usage record as JSON
# omarchy:args=[--force] [--limits-only] [--cache-seconds N]
# omarchy:hidden=true
"""Collect OpenCode Go usage into one display-ready JSON record.

Limits come from the official (undocumented) Go usage endpoint; local token
stats come from opencode.db, filtered to the opencode-go provider. The agents
panel only ever reads the JSON this prints.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import http.client
import json
import os
import sqlite3
import stat
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Optional

AGENT_ID = "opencode-go"
AGENT_NAME = "OpenCode Go"
AUTH_HELP = "Sign in to OpenCode Go, or set OPENCODE_GO_API_KEY."
TIER_LABEL = "Go"
REAL_ENDPOINT = "https://opencode.ai/zen/go/v1/usage"
USER_AGENT = "omarchy-agent-usage/1.0"
TIMEOUT_SECONDS = 10
PROBE_MIN_INTERVAL_SECONDS = 15
MAX_FALLBACK_AGE_SECONDS = 24 * 3600
BODY_LIMIT = 65536
READ_CHUNK = 8192
# Untrusted-input bounds. auth.json and the caches are read with these caps;
# a hostile oversized/foreign file is refused before it is parsed.
MAX_JSON_BYTES = 1_048_576
MAX_KEY_LEN = 512
MAX_LABEL_LEN = 128
MAX_CACHE_ENTRIES = 64
# opencode.db scan bounds: rows examined, wall-clock budget, and cardinality.
MAX_DB_ROWS = 200_000
MAX_DB_DEADLINE_SECONDS = 5.0
MAX_MODELS = 1_000
MAX_SESSIONS = 100_000
MAX_FIELD_LEN = 200
WINDOW_LABELS = (
    ("rolling", "Session (5-hour)"),
    ("weekly", "Weekly (7-day)"),
    ("monthly", "Monthly (30-day)"),
)


def now_ms() -> int:
    return round(time.time() * 1000)


def xdg_data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
    root.mkdir(parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    return root


def read_json(path: Path, max_bytes: int = MAX_JSON_BYTES) -> Any:
    """Read a small, local, trusted-owner JSON file.

    Refuses symlinks, non-regular files, files not owned by this user, and
    anything larger than ``max_bytes``. Any failure is best-effort -> None.
    """
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            return None
        if info.st_uid != os.getuid():
            return None
        if info.st_size > max_bytes:
            return None
        with open(path, "r", encoding="utf-8") as fh:
            data = fh.read(max_bytes + 1)
        if len(data) > max_bytes:
            return None
        return json.loads(data)
    except (OSError, ValueError):
        return None


def write_json_private(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, separators=(",", ":"), sort_keys=True)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def number(value: Any) -> int:
    if type(value) is int:
        return value
    if isinstance(value, float) and value.is_integer():
        return int(value)
    return 0


def real_number(value: Any) -> Optional[float]:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def resolve_key() -> str:
    for name in ("OPENCODE_GO_API_KEY", "OPENCODE_API_KEY"):
        candidate = (os.environ.get(name) or "").strip()
        if candidate and len(candidate) <= MAX_KEY_LEN:
            return candidate
    data = read_json(xdg_data_home() / "opencode" / "auth.json")
    if isinstance(data, dict):
        entry = data.get("opencode-go")
        if isinstance(entry, dict):
            key = entry.get("key")
            if isinstance(key, str):
                key = key.strip()
                if key and len(key) <= MAX_KEY_LEN:
                    return key
    return ""


def endpoint_url() -> str:
    raw = os.environ.get("OPENCODE_GO_USAGE_URL") or ""
    if not raw:
        return REAL_ENDPOINT
    try:
        parsed = urllib.parse.urlsplit(raw)
    except ValueError:
        return REAL_ENDPOINT
    host = (parsed.hostname or "").lower().rstrip(".")
    if parsed.scheme not in ("http", "https"):
        return REAL_ENDPOINT
    if parsed.username or parsed.password:
        return REAL_ENDPOINT
    if parsed.query or parsed.fragment:
        return REAL_ENDPOINT
    if host not in ("127.0.0.1", "::1", "localhost"):
        return REAL_ENDPOINT
    try:
        port = parsed.port
    except ValueError:
        return REAL_ENDPOINT
    if not host:
        return REAL_ENDPOINT
    netloc = f"[{host}]" if ":" in host else host
    if port:
        netloc = f"{netloc}:{port}"
    return urllib.parse.urlunsplit((parsed.scheme, netloc, parsed.path or "/", "", ""))


def parse_usage(payload: Any) -> list:
    if not isinstance(payload, dict):
        return []
    usage = payload.get("usage")
    if not isinstance(usage, dict):
        return []
    limits = []
    for key, label in WINDOW_LABELS:
        window = usage.get(key)
        if not isinstance(window, dict) or window.get("status") != "ok":
            continue
        percent = real_number(window.get("percent"))
        if percent is None or percent < 0 or percent > 100:
            continue
        resets = window.get("resetsAt")
        limits.append({
            "label": label,
            "percent": max(0.0, min(1.0, percent / 100.0)),
            "resetsAt": resets if isinstance(resets, str) else "",
        })
    return limits


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def probe_limits(key: str) -> dict:
    url = endpoint_url()
    request = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {key}", "User-Agent": USER_AGENT},
    )
    opener = urllib.request.build_opener(_NoRedirect)
    # Absolute deadline: a per-read timeout alone lets a peer keep the loop
    # alive by dribbling chunks; check elapsed time on every read.
    deadline = time.monotonic() + TIMEOUT_SECONDS
    try:
        response = opener.open(request, timeout=TIMEOUT_SECONDS)
    except urllib.error.HTTPError as error:
        if error.code == 401:
            return {"ok": False, "limits": [], "state": "Sign-in expired", "transport": False}
        if error.code == 403:
            return {"ok": False, "limits": [], "state": "No Go subscription", "transport": False}
        return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
    except (urllib.error.URLError, OSError, ValueError):
        return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}

    try:
        status = response.status
        if status < 200 or status >= 300:
            return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
        total = 0
        chunks = []
        while True:
            if time.monotonic() > deadline:
                return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
            chunk = response.read(min(READ_CHUNK, BODY_LIMIT + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > BODY_LIMIT:
                return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
            chunks.append(chunk)
        raw = b"".join(chunks)
    except (OSError, http.client.HTTPException):
        return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
    finally:
        response.close()

    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}

    limits = parse_usage(payload)
    if not limits:
        return {"ok": False, "limits": [], "state": "OpenCode Go limits unavailable", "transport": True}
    return {"ok": True, "limits": limits, "state": "", "transport": False}


def limits_cache_path() -> Path:
    return cache_root() / f"{AGENT_ID}-limits.json"


def _parse_iso_utc(value: Any) -> Optional[dt.datetime]:
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


def _valid_cached_limits(cache: Any) -> list:
    if not isinstance(cache, dict):
        return []
    limits = cache.get("limits")
    if not isinstance(limits, list) or type(cache.get("fetchedAtMs")) is not int:
        return []
    clean = []
    for entry in limits:
        if not isinstance(entry, dict):
            return []
        percent = entry.get("percent")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)):
            return []
        if not (0.0 <= float(percent) <= 1.0):
            return []
        clean.append({
            "label": str(entry.get("label") or "Limit"),
            "percent": float(percent),
            "resetsAt": entry.get("resetsAt") if isinstance(entry.get("resetsAt"), str) else "",
        })
    return clean


def usable_fallback(cache: Any, now: dt.datetime) -> list:
    limits = _valid_cached_limits(cache)
    if not limits:
        return []
    age_ms = now_ms() - cache["fetchedAtMs"]
    if age_ms > MAX_FALLBACK_AGE_SECONDS * 1000:
        return []
    alive = []
    for entry in limits:
        reset = _parse_iso_utc(entry.get("resetsAt"))
        if reset is None or reset > now:
            alive.append(entry)
    return alive


def collect_limits(key: str, force: bool) -> dict:
    path = limits_cache_path()
    cache = read_json(path)
    fallback = usable_fallback(cache, dt.datetime.now(dt.timezone.utc))

    if fallback and not force:
        fetched_at = cache.get("fetchedAtMs", 0) / 1000.0
        if time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
            return {"limits": fallback, "state": "", "retry": False}

    probe = probe_limits(key)
    if probe["ok"]:
        write_json_private(path, {"fetchedAtMs": now_ms(), "limits": probe["limits"]})
        return {"limits": probe["limits"], "state": "", "retry": False}

    if probe["transport"]:
        return {"limits": fallback, "state": probe["state"], "retry": True}
    return {"limits": [], "state": probe["state"], "retry": False}


def empty_stats() -> dict:
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "modelUsage": {},
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
    }


def recent_date_strings() -> list:
    today = dt.datetime.now().date()
    return [(today - dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def _bucket() -> dict:
    return {"inputTokens": 0, "outputTokens": 0,
            "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0}


def stats_cache_path(db: Path) -> Path:
    digest = hashlib.sha1(str(db).encode("utf-8")).hexdigest()[:16]
    return cache_root() / f"{AGENT_ID}-opencode-{digest}.json"


def _valid_cached_stats(cache: Any) -> Optional[dict]:
    if not isinstance(cache, dict):
        return None
    stats = cache.get("stats")
    if not isinstance(stats, dict):
        return None
    for key in ("todayPrompts", "todaySessions", "todayTotalTokens",
                "totalPrompts", "totalSessions", "activeDays"):
        if type(stats.get(key)) is not int:
            return None
    recent = stats.get("recentDays")
    if not isinstance(recent, list):
        return None
    for entry in recent:
        if not isinstance(entry, dict) or not isinstance(entry.get("date"), str):
            return None
        if type(entry.get("messageCount")) is not int:
            return None
    active = stats.get("activeDates")
    if not isinstance(active, list) or any(not isinstance(entry, str) for entry in active):
        return None
    for mapping_key in ("todayTokensByModel", "modelUsage"):
        mapping = stats.get(mapping_key)
        if not isinstance(mapping, dict):
            return None
        for value in mapping.values():
            if mapping_key == "todayTokensByModel":
                if type(value) is not int:
                    return None
            elif not isinstance(value, dict) or any(type(v) is not int for v in value.values()):
                return None
    return stats


def scan_local_stats(max_age: int) -> Optional[dict]:
    # The unresolved path keys the cache; only the resolved path opens the DB.
    try:
        db = (xdg_data_home() / "opencode" / "opencode.db").expanduser()
    except (OSError, RuntimeError):
        return None
    if not db.is_file():
        return None

    try:
        cache_path = stats_cache_path(db)
    except OSError:
        cache_path = None
    if cache_path is not None:
        cached = read_json(cache_path)
        if not isinstance(cached, dict):
            cached = None
        if cached is not None:
            if type(cached.get("cachedAtMs")) is int and (time.time() * 1000 - cached["cachedAtMs"]) <= max_age * 1000:
                stats = _valid_cached_stats(cached)
                if stats is not None:
                    return stats

    today = dt.datetime.now().strftime("%Y-%m-%d")
    recent = {day: 0 for day in recent_date_strings()}
    sessions, active_days, today_sessions = set(), set(), set()
    model_usage, today_by_model = {}, {}
    today_prompts = today_tokens = prompts = 0
    started = time.monotonic()

    try:
        conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    except (sqlite3.Error, OSError, RuntimeError):
        return None
    try:
        conn.execute("PRAGMA query_only = ON")
        conn.execute("PRAGMA busy_timeout = 2000")
        # Stream with a hard row cap and a wall-clock budget; never materialize
        # the whole table, and cap the cardinality of everything derived from
        # attacker-controlled DB strings.
        cursor = conn.execute("SELECT session_id, data FROM message LIMIT ?", (MAX_DB_ROWS,))
        for session_id, raw in cursor:
            if time.monotonic() - started > MAX_DB_DEADLINE_SECONDS:
                break
            if not isinstance(raw, str) or len(raw) > MAX_JSON_BYTES:
                continue
            try:
                entry = json.loads(raw)
                if not isinstance(entry, dict) or entry.get("role") != "assistant":
                    continue
                if str(entry.get("providerID") or "") != AGENT_ID:
                    continue
                tokens = entry.get("tokens") or {}
                cache = tokens.get("cache") or {}
                inp = number(tokens.get("input"))
                out = number(tokens.get("output")) + number(tokens.get("reasoning"))
                cr = number(cache.get("read"))
                cw = number(cache.get("write"))
                total = inp + out + cr + cw
                if total <= 0:
                    continue
                created = number((entry.get("time") or {}).get("created"))
                if created > 0:
                    day = dt.datetime.fromtimestamp(created / 1000).strftime("%Y-%m-%d")
                else:
                    day = today
                model = str(entry.get("modelID") or AGENT_ID).rstrip("/").split("/")[-1][:MAX_FIELD_LEN] or "unknown"
            except Exception:
                continue
            session_key = "opencode:" + str(session_id)[:MAX_FIELD_LEN]
            if len(sessions) < MAX_SESSIONS:
                sessions.add(session_key)
            active_days.add(day)
            prompts += 1
            if model in model_usage or len(model_usage) < MAX_MODELS:
                bucket = model_usage.setdefault(model, _bucket())
                bucket["inputTokens"] += inp
                bucket["outputTokens"] += out
                bucket["cacheReadInputTokens"] += cr
                bucket["cacheCreationInputTokens"] += cw
            if day in recent:
                recent[day] += total
            if day == today:
                today_prompts += 1
                if len(today_sessions) < MAX_SESSIONS:
                    today_sessions.add(session_key)
                today_tokens += total
                if model in today_by_model or len(today_by_model) < MAX_MODELS:
                    today_by_model[model] = today_by_model.get(model, 0) + total
    except sqlite3.Error:
        return None
    finally:
        conn.close()

    if prompts == 0:
        stats = None
    else:
        stats = {
            "todayPrompts": today_prompts,
            "todaySessions": len(today_sessions),
            "todayTotalTokens": today_tokens,
            "todayTokensByModel": today_by_model,
            "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent],
            "modelUsage": model_usage,
            "totalPrompts": prompts,
            "totalSessions": len(sessions),
            "activeDays": len(active_days),
            "activeDates": sorted(active_days),
        }
    if cache_path is not None:
        try:
            write_json_private(cache_path, {"cachedAtMs": now_ms(), "stats": stats})
        except OSError:
            pass
    return stats


def build_record(limits_result: dict, stats: Optional[dict]) -> dict:
    has_local = stats is not None
    stats = stats or empty_stats()
    limits = limits_result.get("limits") or []
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": bool(limits) or number(stats.get("totalPrompts")) > 0
        or number(stats.get("todayPrompts")) > 0 or number(stats.get("activeDays")) > 0,
        "hasLocalStats": has_local,
        "tierLabel": TIER_LABEL,
        "usageStatusText": str(limits_result.get("state") or ""),
        "authHelpText": AUTH_HELP,
        "limits": limits,
    }
    if limits_result.get("retry"):
        record["retryAdvised"] = True
    record.update({k: stats.get(k, empty_stats()[k]) for k in empty_stats()})
    return record


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.add_argument("--cache-seconds", type=float, default=20)
    args = parser.parse_args()

    try:
        key = resolve_key()
        if key:
            limits_result = collect_limits(key, args.force)
        else:
            limits_result = {"limits": [], "state": "Waiting for auth", "retry": False}
        max_age = 0 if args.force else (900 if args.limits_only else int(args.cache_seconds))
        stats = scan_local_stats(max_age)
        record = build_record(limits_result, stats)
        payload = json.dumps(record, separators=(",", ":"), sort_keys=True)
    except Exception as error:  # noqa: BLE001 - never leak a traceback to stdout
        print(f"omarchy-agent-usage-opencode-go: {type(error).__name__}: {error}", file=sys.stderr)
        return 1
    print(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
